projection;
strict ( 2 );
use draft;

define behavior for zc_conteo_cas alias Conteo
{
  use create;
  use update;
  use delete;

  use action acceptConteo;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _DetalleConteo { create; with draft; }
}

define behavior for zc_det_conteo_cas alias DetalleConteo
{
  use update;
  use delete;

  use association _Conteo { with draft; }
}